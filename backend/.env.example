# Server Port (default: 5000)
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=production

# Server Host binding (0.0.0.0 for cloud/docker/render, 127.0.0.1 for local only)
HOST=0.0.0.0

# CORS Allowed Origin (use * for all, or comma-separated URLs like http://localhost:5173,https://your-frontend.vercel.app)
CLIENT_ORIGIN=*
